# ============================================
# Git Whitelist - Only Source Code
# ============================================

# Block everything by default
*

# Allow source directories
!HMCL/src/
!HMCL/src/**/
!HMCL/src/**/*
!HMCLCore/src/
!HMCLCore/src/**/
!HMCLCore/src/**/*
!HMCLBoot/src/
!HMCLBoot/src/**/
!HMCLBoot/src/**/*
!buildSrc/src/
!buildSrc/src/**/
!buildSrc/src/**/*

# Allow gradle build scripts
!build.gradle.kts
!settings.gradle.kts
!gradle/libs.versions.toml
!HMCL/build.gradle.kts
!HMCLCore/build.gradle.kts
!HMCLBoot/build.gradle.kts
!buildSrc/build.gradle.kts
!buildSrc/settings.gradle.kts

# Allow gradle wrapper
!gradle/
!gradle/wrapper/
!gradle/wrapper/*
!gradlew
!gradlew.bat

# Allow config files
!config/
!config/**/
!config/**/*

# Allow documentation
!LICENSE
!README.md

# Allow resources (assets)
!HMCL/src/main/resources/
!HMCL/src/main/resources/**/
!HMCL/src/main/resources/**/*
!HMCLCore/src/main/resources/
!HMCLCore/src/main/resources/**/
!HMCLCore/src/main/resources/**/*

# ============================================
# Exclusions (even within allowed directories)
# ============================================

# Local replacement assets
assets-local/

# Build outputs
.gradle/
build/
**/build/

# IDE files
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.vscode/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.bak
*.swp
*~

# Launcher data
.gradle-user-home/
.hmcl/
.minecraft/

# Project temp
.cnb/
.gemini/
.trae/
.comate/

# Logs
*.log
*.log.xz

# Libraries
lib/

# Images
HMCL/image/
HMCLBoot/image/
_icon_preview.png

# Start scripts
start-*.bat
start-*.sh

# GitHub/Git workflows
.github/
.gitee/

# Minecraft libraries
minecraft/

# Gradle wrapper backup
gradle-9.5.1/
HMCL/gradle/wrapper/
