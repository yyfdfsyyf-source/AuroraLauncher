{
  "id": "cyberpunk",
  "name": "赛博朋克",
  "version": "1.0",
  "author": "HMCL",
  "description": "霓虹赛博朋克风格主题，锐利的边角设计和边框",
  "primaryColor": "#00BCD4",
  "layout": {
    "cornerRadius": 4.0,
    "buttonRadius": 4.0,
    "cardRadius": 4.0,
    "inputRadius": 4.0,
    "borderWidth": 1.5,
    "borderColor": "rgba(0, 188, 212, 0.5)",
    "fontFamily": "Consolas",
    "fontSize": 14.0,
    "iconSize": 18.0,
    "animationEnabled": false,
    "animationDuration": 150.0,
    "sidebarPosition": "left",
    "titlebarHeight": null,
    "contentPadding": 10.0
  },
  "css": ""
}
